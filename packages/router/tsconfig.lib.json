{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "useDefineForClassFields": false,
    "paths": {
      "@benpsnyder/analogjs-esm-content": [
        "./node_modules/@benpsnyder/analogjs-esm-content"
      ]
    }
  },
  "exclude": ["vite.config.ts", "**/*.test.ts", "**/*.spec.ts"],
  "include": ["**/*.ts"]
}
