{
  "$schema": "https://jsr.io/schema/config-file.v1.json",
  "name": "@benpsnyder/analogjs-esm-platform",
  "version": "2.0.0-alpha.16.1",
  "description": "The fullstack meta-framework for Angular - ESM edition",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/benpsnyder/analog.git"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publish": {
    "exclude": [
      "**/*.spec.ts",
      "**/*.test.ts",
      "**/test-setup.ts",
      "**/__tests__/**",
      "**/coverage/**",
      "**/node_modules/**",
      "**/*.map",
      "migrations/**",
      "tsconfig.*.json",
      "jest.config.*",
      "vite.config.*"
    ]
  },
  "peerDependencies": {
    "@nx/angular": "^16.0.0 || ^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0",
    "@nx/devkit": "^16.0.0 || ^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0",
    "@nx/vite": "^16.0.0 || ^17.0.0 || ^18.0.0 || ^19.0.0 || ^20.0.0 || ^21.0.0",
    "marked": "^15.0.7",
    "marked-gfm-heading-id": "^4.1.1",
    "marked-highlight": "^2.2.1",
    "marked-mangle": "^1.1.10",
    "marked-shiki": "^1.1.0",
    "shiki": "^1.6.1",
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  }
}
